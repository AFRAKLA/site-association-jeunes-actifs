# Copiez ce fichier en .env.local et remplissez les valeurs réelles.
# Ne jamais committer .env.local (déjà ignoré par .gitignore).

# --- Supabase ---
# URL du projet Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co
# Clé publique "anon" (Project Settings > API > anon public)
SUPABASE_ANON_KEY=your-anon-key
# Clé secrète "service_role" (Project Settings > API > service_role)
# Ne doit JAMAIS être exposée côté client — utilisée uniquement dans les routes API admin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Espace admin ---
# Mot de passe unique protégeant /admin et les routes /api/admin/*
ADMIN_PASSWORD=change-me

# --- Resend (envoi d'emails) ---
# Clé API Resend (resend.com > API Keys)
RESEND_API_KEY=your-resend-api-key
# Adresse d'expédition des emails (doit être un domaine vérifié dans Resend)
EMAIL_FROM=contact@example.com
# Nom affiché dans l'expéditeur (optionnel)
EMAIL_FROM_NAME=Association Jeunes Actifs
