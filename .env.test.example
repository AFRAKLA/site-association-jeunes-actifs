# Copiez ce fichier en .env.test et remplissez-le avec les identifiants d'un
# SECOND projet Supabase DÉDIÉ AUX TESTS — jamais le même projet que celui de
# .env.local (production). Ne jamais committer .env.test (déjà ignoré par
# .gitignore, comme .env.local).
#
# Pourquoi un projet séparé plutôt que des mocks uniquement : cela permet de
# tester le vrai comportement de bout en bout (vraies policies RLS, vrai
# Storage, vraie fonction check_rate_limit) sans risquer d'écrire dans la
# production — voir docs/testing-strategy.md pour le détail de la stratégie
# et scripts/guard-against-production.mjs pour la protection automatique.

# --- Supabase (projet de TEST, distinct de la production) ---
SUPABASE_URL=https://your-test-project-ref.supabase.co
SUPABASE_ANON_KEY=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# --- Espace admin (peut être identique ou différent de la production) ---
ADMIN_PASSWORD=test-only-password
ADMIN_SESSION_SECRET=test-only-session-secret

# --- Resend ---
# Recommandé : une clé API Resend en mode test/sandbox si votre compte en
# propose une, pour qu'aucun email réel ne parte jamais pendant les tests.
# À défaut, une clé valide reste possible mais ATTENTION : elle enverrait de
# vrais emails si un test appelle réellement envoyerEmail().
RESEND_API_KEY=your-test-or-sandbox-resend-key
EMAIL_FROM=test@example.com
EMAIL_FROM_NAME=Association Jeunes Actifs (TEST)
